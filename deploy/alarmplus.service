[Unit]
Description=Alarm+ (smile to dismiss)
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/python -m alarmplus --config @ROOT@/config.toml
Restart=always
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
